# ==============================================================================
# NEXORA AI – PRODUCTION ENVIRONMENT TEMPLATE
# Do NOT commit populated `.env.production` with live secrets.
# ==============================================================================

APP_NAME="NEXORA AI"
ENVIRONMENT=production
DEBUG=false
STRICT_SECRET_VALIDATION=true

# CRITICAL: Must be >= 32 chars and unique per environment (openssl rand -hex 32)
SECRET_KEY=REPLACE_WITH_PRODUCTION_64_HEX_CHAR_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=14

# Managed PostgreSQL & Redis
DATABASE_URL=postgresql+asyncpg://nexora_prod:REPLACE_STRONG_DB_PASSWORD@postgres:5432/nexora_prod
POSTGRES_DB=nexora_prod
POSTGRES_USER=nexora_prod
POSTGRES_PASSWORD=REPLACE_STRONG_DB_PASSWORD
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# Strict Production CORS Origins
CORS_ORIGINS=https://nexora.ai,https://app.nexora.ai

# External AI Providers & Grounding
DEFAULT_MODEL_ID=nexora-auto
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
TAVILY_API_KEY=

# S3 / R2 / GCS S3-Compatible Object Storage
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=nexora-prod-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
BACKUP_DIR=/app/backups

# Commercial Billing (Live Stripe Keys)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rate Limiting & Browser Sandboxing
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_RPM=120
RATE_LIMIT_AUTH_RPM=20
ALLOWED_BROWSER_DOMAINS=

NEXT_PUBLIC_API_URL=https://api.nexora.ai
