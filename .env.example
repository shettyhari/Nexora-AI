# ==============================================================================
# NEXORA AI – ROOT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Settings
APP_NAME="NEXORA AI"
DEBUG=false

# Security & Secrets (Generate with: openssl rand -hex 32)
SECRET_KEY=nexora_ai_super_secret_jwt_encryption_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration
# Local Quickstart (SQLite): sqlite+aiosqlite:///./nexora.db
# Production / Docker (PostgreSQL): postgresql+asyncpg://postgres:postgres@localhost:5432/nexora
DATABASE_URL=sqlite+aiosqlite:///./nexora.db
DATABASE_ECHO=false

# PostgreSQL Credentials (for Docker Compose)
POSTGRES_DB=nexora
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Cache & Sessions
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# AI Provider API Keys (Set at least one for live cloud intelligence)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Default Active Model ID (nexora-pro | nexora-flash | gpt-4o | claude-3-5-sonnet)
DEFAULT_MODEL_ID=nexora-pro

# Web Search Integration (Optional: for real-time live search grounding)
TAVILY_API_KEY=
SERPAPI_API_KEY=
ENABLE_WEB_SEARCH=true

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
