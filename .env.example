# ==============================================================================
# NEXORA AI – ROOT CONFIGURATION TEMPLATE (DEVELOPMENT / QUICKSTART)
# ==============================================================================

APP_NAME="NEXORA AI"
ENVIRONMENT=development
DEBUG=false
STRICT_SECRET_VALIDATION=false

# Security & Secrets (Generate with: openssl rand -hex 32)
SECRET_KEY=nexora_ai_super_secret_jwt_encryption_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration
# Local Quickstart (SQLite): sqlite+aiosqlite:///./nexora.db
# Docker / PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/nexora
DATABASE_URL=sqlite+aiosqlite:///./nexora.db
DATABASE_ECHO=false

POSTGRES_DB=nexora
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Cache & Sessions
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# AI Provider API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
HUGGINGFACE_ENDPOINT_URL=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

DEFAULT_MODEL_ID=nexora-auto

# Intelligence Engine Settings
ENABLE_INTELLIGENT_ROUTING=true
ENABLE_MEMORY=true
ENABLE_RAG=true
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small

# Web Search & Browser Security
TAVILY_API_KEY=
SERPAPI_API_KEY=
ENABLE_WEB_SEARCH=true
ALLOWED_BROWSER_DOMAINS=

# Commercial Billing & Payment Provider
PAYMENT_PROVIDER=local
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Object Storage & Backups
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=nexora-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
BACKUP_DIR=./backups

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_RPM=120
RATE_LIMIT_AUTH_RPM=30

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
