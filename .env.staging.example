# ==============================================================================
# NEXORA AI – STAGING ENVIRONMENT TEMPLATE
# ==============================================================================

APP_NAME="NEXORA AI (Staging)"
ENVIRONMENT=staging
DEBUG=false
STRICT_SECRET_VALIDATION=true

# Generate strong 64-char hex secret: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_STAGING_32_PLUS_CHAR_SECRET_KEY_GENERATED_VIA_OPENSSL
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=14

# Staging PostgreSQL & Redis
DATABASE_URL=postgresql+asyncpg://nexora_staging:REPLACE_PASSWORD@postgres:5432/nexora_staging
POSTGRES_DB=nexora_staging
POSTGRES_USER=nexora_staging
POSTGRES_PASSWORD=REPLACE_PASSWORD
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# CORS
CORS_ORIGINS=https://staging.nexora.ai,http://localhost:3000

# Model Providers & Search
DEFAULT_MODEL_ID=nexora-auto
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
TAVILY_API_KEY=

# S3 Object Storage (Staging Bucket)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
S3_BUCKET=nexora-staging-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
BACKUP_DIR=/app/backups

# Commercial Billing (Stripe Test Mode)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Security & Rate Limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_RPM=120
RATE_LIMIT_AUTH_RPM=30
ALLOWED_BROWSER_DOMAINS=

NEXT_PUBLIC_API_URL=https://staging.nexora.ai
