# Isolated ML Training & Proprietary Model Inference Worker Image
# Strictly separated from public web API routing; runs Torch/Transformers/PEFT/TRL jobs.
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NEXORA_IN_ML_WORKER=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

COPY requirements.txt requirements-training.txt ./
RUN uv pip install --system --no-cache -r requirements.txt -r requirements-training.txt

COPY . .

# Create dedicated workspace directories for isolated lab artifacts
RUN mkdir -p /app/lab_jobs /app/lab_checkpoints /app/lab_data /app/lab_exports /app/lab_optimized /app/backups

# Default entrypoint runs isolated inference/worker health loop; training jobs spawn via worker_runner
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
